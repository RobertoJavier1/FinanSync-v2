# Copiar este archivo como .env.local y rellenar los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.
# Este archivo (.example) sí se sube, así que NO poner claves reales aquí.

# ---------------------------------------------------------------------------
# Supabase
# Dashboard → tu proyecto → botón verde "Connect", o Project Settings → Data API
# ---------------------------------------------------------------------------

# URL del proyecto. Tiene la forma https://xxxxxxxxxxxx.supabase.co
# Sin barra al final y SIN /rest/v1: el cliente de Supabase agrega esa parte solo.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" / "publishable", empieza con sb_publishable_ o eyJ...).
# Es segura en el navegador: todo el acceso a datos lo limitan las políticas RLS
# definidas en supabase/migrations/0001_schema_inicial.sql
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OJO: la service_role / Secret key (sb_secret_...) NO va aquí ni en ninguna
# variable NEXT_PUBLIC_, porque ignora RLS y quedaría expuesta en el navegador.

# ---------------------------------------------------------------------------
# Cuenta de servicio de runtime (finansync-runtime)
# Consola de Google Cloud → IAM → Cuentas de servicio → Claves (JSON).
# La usan Cloud Vision (lectura de facturas) y Vertex AI (chat, perspectivas y
# la interpretacion de las facturas). Va separada de la de Storage para que
# cada una tenga solo los permisos que necesita.
#
# En Cloud Run estas tres variables no hacen falta: el servicio corre con la
# identidad de la cuenta y las credenciales le llegan solas.
# ---------------------------------------------------------------------------

# "project_id" del archivo JSON de la cuenta de servicio
GCP_RUNTIME_PROJECT_ID=

# "client_email" del archivo JSON de la cuenta de servicio
GCP_RUNTIME_CLIENT_EMAIL=

# "private_key" del archivo JSON, entre comillas dobles y con los "\n" tal cual
GCP_RUNTIME_PRIVATE_KEY=

# region del endpoint de Vertex AI. opcional, por defecto us-central1
VERTEX_LOCATION=

# ---------------------------------------------------------------------------
# Google Cloud Storage (imagenes de facturas) — cuenta finansync-storage
# Consola de Google Cloud → Cloud Storage (bucket) + IAM → Cuentas de servicio
# (clave JSON). Solo se usa en el servidor, en app/api/facturas/subir.
# ---------------------------------------------------------------------------

# nombre del bucket (ej. finansync-facturas)
GCS_BUCKET_NAME=

# "project_id" del archivo JSON de la cuenta de servicio
GCS_PROJECT_ID=

# "client_email" del archivo JSON de la cuenta de servicio
GCS_CLIENT_EMAIL=

# "private_key" del archivo JSON de la cuenta de servicio, entre comillas
# dobles y con los "\n" tal cual aparecen (no reemplazar por saltos de linea reales)
GCS_PRIVATE_KEY=
